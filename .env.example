# Model access for live/record runs. Copy to .env (git-ignored) and fill in the values.
# The ./agentic script reads this file as KEY=VALUE data (it is never executed); values that
# still look like "<...>" are treated as unset. Never commit real values: the secret-leak policy
# also blocks agents from writing keys into code or artifacts.
GEMINI_API_KEY="<your-gemini-api-key>"
AGENTIC_MODEL="<gemini-model-name>"
# Optional: a different model used by fallback strategies (defaults to AGENTIC_MODEL).
AGENTIC_FALLBACK_MODEL="<fallback-gemini-model-name>"
# Optional: concurrent model calls allowed for this key (default 2). Lower it if you see 429s.
AGENTIC_MAX_CONCURRENT_CALLS="2"
