# Model access for live/record runs. Copy to .env (git-ignored) or export in your shell.
# Never commit real values: the secret-leak policy also blocks agents from writing keys.
GEMINI_API_KEY=<your-gemini-api-key>
AGENTIC_MODEL=<gemini-model-name>
# Optional: a different model used by fallback strategies (defaults to AGENTIC_MODEL).
AGENTIC_FALLBACK_MODEL=<fallback-gemini-model-name>
