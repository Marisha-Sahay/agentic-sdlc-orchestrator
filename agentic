#!/usr/bin/env bash
# Wrapper for the orchestrator CLI. Builds the jar on first use.
#   ./agentic run brownfield
#   ./agentic run ambiguous --approvals interactive
#   ./agentic metrics
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$ROOT/orchestrator-app/target/agentic.jar"

# Load .env as data, never as code: KEY=VALUE lines only, optional quotes, comments ignored.
# Variables already set in the environment win over .env.
if [[ -f "$ROOT/.env" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]%%[[:space:]]}"
      if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi
      if [[ -z "${!key:-}" ]]; then
        export "$key=$value"
      fi
    fi
  done < "$ROOT/.env"
fi

if [[ ! -f "$JAR" || "${AGENTIC_REBUILD:-}" == "1" ]]; then
  echo "Building orchestrator (first run)..." >&2
  mvn -q -B -ntp -f "$ROOT/pom.xml" -pl orchestrator-app -am package -DskipTests \
    -Dcheckstyle.skip -Djacoco.skip=true >&2
fi

cd "$ROOT"
exec java -jar "$JAR" "$@"
